# Config del proyecto Firebase real (optiblue-prod). El apiKey de Firebase
# Web NO es secreto — la seguridad la dan las Security Rules + Auth, no
# ocultar esta key (así lo documenta Firebase).
VITE_FIREBASE_PROJECT_ID=optiblue-prod
VITE_FIREBASE_API_KEY=AIzaSyCpsOzyU5YEpgvjFfqyKDvRkWvLVixxBsc
VITE_FIREBASE_AUTH_DOMAIN=optiblue-prod.firebaseapp.com
# Requeridos por Firebase Cloud Messaging (push del panel admin, Fase PWA
# 2026-07-12). messagingSenderId/appId obtenidos con
# `firebase apps:sdkconfig WEB --project optiblue-prod` — tampoco son
# secretos. La VAPID key sí identifica el par de claves de Web Push del
# proyecto (Firebase Console → Cloud Messaging → Web Push certificates,
# generada 2026-07-12), pero no es un secreto de servidor: viaja al cliente
# igual que el resto de esta config.
VITE_FIREBASE_MESSAGING_SENDER_ID=637850927864
VITE_FIREBASE_APP_ID=1:637850927864:web:f35db5c8f03ae2b227b10d
VITE_FIREBASE_VAPID_KEY=BIlnwH8CZME6t5Zt6hHSGzTpgdu1Xv9aMSqDolrih81wXnt75aQOH3M5Mt216Eu86-pu8xYPOjQyG0bIi63VOBs

# URLs reales de las Cloud Functions (2ª gen → Cloud Run, no el patrón
# legacy cloudfunctions.net). Desplegadas 2026-07-11.
VITE_FUNCTIONS_BASE_URL=https://apicatalogo-wfllo3swwq-uc.a.run.app
VITE_SEDES_FUNCTIONS_BASE_URL=https://apisedes-wfllo3swwq-uc.a.run.app
VITE_PEDIDOS_FUNCTIONS_BASE_URL=https://apipedidos-wfllo3swwq-uc.a.run.app
VITE_CITAS_FUNCTIONS_BASE_URL=https://apicitas-wfllo3swwq-uc.a.run.app
VITE_COTIZACIONES_FUNCTIONS_BASE_URL=https://apicotizaciones-wfllo3swwq-uc.a.run.app
# apiNotificaciones se creó recién (2026-07-12): todavía en el patrón legacy
# cloudfunctions.net, no el dominio corto *.run.app de las demás (eso se
# asigna después, no afecta el funcionamiento).
VITE_NOTIFICACIONES_FUNCTIONS_BASE_URL=https://us-central1-optiblue-prod.cloudfunctions.net/apiNotificaciones
